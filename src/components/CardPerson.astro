---
interface Props {
	name: string;
	role?: string;
	quote: string;
	photo?: string;
}

const {
	name,
	role = "",
	quote,
	photo = "/images/foto/kepala_desa.jpg",
}: Props = Astro.props;
---
<article class="person-card surface" data-animate>
	<div
		class="person-card__portrait"
		role="img"
		aria-label={`Foto ${name}`}
		style={`background-image: linear-gradient(135deg, rgba(144, 202, 249, 0.45), rgba(255, 224, 130, 0.45)), url('${photo}')`}
	></div>
	<div class="person-card__content">
		<p class="person-card__quote">“{quote}”</p>
		<p class="person-card__name">
			{name}
			{role && <span>{role}</span>}
		</p>
	</div>
</article>

<style>
	.person-card {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 1.75rem;
		align-items: center;
		padding: 2rem;
	}

	.person-card__portrait {
		width: 160px;
		aspect-ratio: 1 / 1;
		border-radius: 32px;
		background-size: cover;
		background-position: center;
		box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.35);
	}

	.person-card__content {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.person-card__quote {
		font-size: 1.05rem;
		color: var(--color-text);
		font-weight: 500;
	}

	.person-card__name {
		font-weight: 600;
		color: var(--color-text);
		margin: 0;
	}

	.person-card__name span {
		display: block;
		font-size: 0.9rem;
		color: var(--color-muted);
		font-weight: 500;
		margin-top: 0.2rem;
	}

	@media (max-width: 720px) {
		.person-card {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.person-card__portrait {
			margin: 0 auto;
		}
	}
</style>
