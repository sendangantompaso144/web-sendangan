---
const quickLinks = [
	{ href: "/profil", label: "Profil" },
	{ href: "/program", label: "Program" },
	{ href: "/galeri", label: "Galeri" },
	{ href: "/data", label: "Data" },
	{ href: "/cerita", label: "Cerita" },
	{ href: "/kontak", label: "Kontak" },
	{ href: "/kkt", label: "KKT 144" },
];
---
<footer class="site-footer">
	<div class="container footer__grid">
		<div class="footer__brand">
			<h2>Desa Sendangan</h2>
			<p>Website resmi Desa Sendangan, Tompaso. Mengarsipkan cerita, program, dan data warga agar tetap hidup.</p>
			<div class="footer__contact">
				<span class="badge-accent">Pelayanan Kantor</span>
				<p>Senin - Jumat · 08.00 - 15.00 WITA</p>
			</div>
		</div>
		<div class="footer__links">
			<h3>Navigasi</h3>
			<ul>
				{quickLinks.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))}
			</ul>
		</div>
		<div class="footer__meta">
			<h3>Hubungi Kami</h3>
			<ul>
				<li>Email: <a href="mailto:sendangan.desa@gmail.com">sendangan.desa@gmail.com</a></li>
				<li>WhatsApp: <a href="https://wa.me/6281234567890">+62 812-3456-7890</a></li>
				<li>Alamat: Jl. Raya Tompaso No. 1, Desa Sendangan</li>
			</ul>
		</div>
	</div>
	<div class="footer__bottom">
		<div class="container footer__bottom-inner">
			<span>© 2025 KKT 144 UNSRAT Desa Sendangan, Tompaso</span>
			<span>Dengan bangga untuk warga Sendangan</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		background: radial-gradient(circle at top, rgba(144, 202, 249, 0.25), rgba(249, 250, 251, 0.95));
		color: var(--color-text);
	}

	.footer__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2.5rem;
		padding: clamp(3rem, 6vw, 4.5rem) 0;
	}

	.footer__brand p {
		max-width: 360px;
	}

	.footer__contact {
		margin-top: 1.5rem;
	}

	.footer__links ul,
	.footer__meta ul {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.65rem;
	}

	.footer__links a,
	.footer__meta a {
		color: inherit;
		text-decoration: none;
	}

	.footer__links a:hover,
	.footer__links a:focus-visible,
	.footer__meta a:hover,
	.footer__meta a:focus-visible {
		text-decoration: underline;
		text-decoration-color: rgba(144, 202, 249, 0.7);
	}

	.footer__bottom {
		border-top: 1px solid rgba(38, 50, 56, 0.08);
		background: rgba(255, 255, 255, 0.8);
	}

	.footer__bottom-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.25rem 0;
		font-size: 0.92rem;
		color: var(--color-muted);
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	@media (max-width: 960px) {
		.footer__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.footer__grid {
			grid-template-columns: 1fr;
		}

		.footer__bottom-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
