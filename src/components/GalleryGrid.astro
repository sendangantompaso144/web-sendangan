---
interface ImageItem {
	src: string;
	alt: string;
}

interface Props {
	images: ImageItem[];
}

const { images = [] }: Props = Astro.props;
---
<div class="gallery-grid">
	{images.map((image) => (
		<figure
			class="gallery-grid__item"
			role="img"
			aria-label={image.alt}
			style={`background-image: linear-gradient(135deg, rgba(144, 202, 249, 0.28), rgba(255, 224, 130, 0.22)), url('${image.src}')`}
		></figure>
	))}
</div>

<style>
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
	}

	.gallery-grid__item {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-large);
		background-size: cover;
		background-position: center;
		box-shadow: var(--shadow-soft);
	}

	@media (max-width: 720px) {
		.gallery-grid {
			gap: 0.75rem;
		}
	}
</style>
