---
interface Props {
	title: string;
	description: string;
	image?: string;
	highlight?: string;
}

const { title, description, image = "/images/dokumentasi/program_web.jpg", highlight }: Props = Astro.props;
---
<article class="program-card surface" data-animate>
	<div
		class="program-card__thumb"
		role="img"
		aria-label={`Foto program ${title}`}
		style={`background-image: linear-gradient(135deg, rgba(144, 202, 249, 0.35), rgba(255, 224, 130, 0.35)), url('${image}')`}
	></div>
	<div class="program-card__body">
		{highlight && <span class="badge-accent">{highlight}</span>}
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</article>

<style>
	.program-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: var(--radius-large);
		min-height: 100%;
	}

	.program-card__thumb {
		width: 100%;
		padding-top: 60%;
		background-size: cover;
		background-position: center;
	}

	.program-card__body {
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.program-card__body h3 {
		margin: 0;
		font-size: 1.25rem;
	}

	.program-card__body p {
		margin: 0;
	}

	@media (max-width: 720px) {
		.program-card__body {
			padding: 1.5rem;
		}
	}
</style>
