---
interface Props {
  judul: string;
  deskripsi: string;
  gambar: string;
  link?: string;
}

const { judul, deskripsi, gambar, link } = Astro.props;
const Tag = link ? 'a' : 'div';
---

<Tag href={link} class="program-card card">
  <div class="program-image">
    <img src={gambar} alt={judul} loading="lazy" />
  </div>
  <div class="program-content">
    <h3 class="program-title">{judul}</h3>
    <p class="program-description">{deskripsi}</p>
    {link && (
      <span class="program-link">
        Lihat Detail
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    )}
  </div>
</Tag>

<style>
  .program-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .program-image {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-secondary);
  }

  .program-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .program-card:hover .program-image img {
    transform: scale(1.1);
  }

  .program-content {
    padding: var(--spacing-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .program-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
    line-height: 1.3;
  }

  .program-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0.8;
    flex: 1;
  }

  .program-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-md);
    color: var(--color-primary);
    font-weight: 500;
    font-size: 0.875rem;
    transition: gap 0.3s ease;
  }

  .program-card:hover .program-link {
    gap: var(--spacing-sm);
  }

  .program-link svg {
    transition: transform 0.3s ease;
  }

  .program-card:hover .program-link svg {
    transform: translateX(4px);
  }
</style>
