---
const navLinks = [
	{ href: "/", label: "Beranda" },
	{ href: "/profil", label: "Profil" },
	{ href: "/program", label: "Program" },
	{ href: "/galeri", label: "Galeri" },
	{ href: "/data", label: "Data" },
	{ href: "/cerita", label: "Cerita" },
	{ href: "/kontak", label: "Kontak" },
];
---
<header class="site-header" role="banner">
	<div class="container header__content">
		<a class="brand" href="/" aria-label="Halaman utama Desa Sendangan">
			<span class="brand__title">Desa Sendangan</span>
			<span class="brand__tagline">Tompaso, Minahasa</span>
		</a>
		<nav class="header__nav" aria-label="Navigasi utama">
			<button class="menu-toggle" type="button" aria-expanded="false" data-menu-button>
				<span aria-hidden="true">☰</span>
				<span class="sr-only">Buka navigasi</span>
			</button>
			<ul class="nav__list" data-nav>
				{navLinks.map((link) => (
					<li class="nav__item">
						<a class="nav__link" href={link.href}>{link.label}</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<script is:inline>
	const header = document.querySelector(".site-header");
	const menuButton = header?.querySelector("[data-menu-button]");
	const navList = header?.querySelector("[data-nav]");

		const toggleMenu = () => {
			if (!menuButton || !navList) return;
			const isOpen = menuButton.getAttribute("aria-expanded") === "true";
			menuButton.setAttribute("aria-expanded", String(!isOpen));
			navList.toggleAttribute("data-open", !isOpen);
			const label = menuButton.querySelector(".sr-only");
			if (label) {
				label.textContent = !isOpen ? "Tutup navigasi" : "Buka navigasi";
			}
		};

	menuButton?.addEventListener("click", toggleMenu);

		navList?.querySelectorAll("a").forEach((anchor) => {
			anchor.addEventListener("click", () => {
				if (!menuButton || !navList) return;
				if (window.innerWidth > 720) return;
				menuButton.setAttribute("aria-expanded", "false");
				navList.removeAttribute("data-open");
				const label = menuButton.querySelector(".sr-only");
				if (label) {
					label.textContent = "Buka navigasi";
				}
			});
		});

	window.addEventListener("resize", () => {
		if (!menuButton || !navList) return;
			if (window.innerWidth > 720) {
				menuButton.setAttribute("aria-expanded", "false");
				navList.removeAttribute("data-open");
				const label = menuButton.querySelector(".sr-only");
				if (label) {
					label.textContent = "Buka navigasi";
				}
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 150;
		backdrop-filter: blur(12px);
		background: rgba(249, 250, 251, 0.8);
		border-bottom: 1px solid rgba(38, 50, 56, 0.08);
	}

	.header__content {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: var(--header-height);
		gap: 1.5rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.brand__title {
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.brand__tagline {
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--color-muted);
	}

	.header__nav {
		display: flex;
		align-items: center;
	}

	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 50%;
		border: 1px solid rgba(38, 50, 56, 0.15);
		background: rgba(255, 255, 255, 0.85);
		font-size: 1.35rem;
		cursor: pointer;
	}

	.menu-toggle:focus-visible {
		outline: 3px solid rgba(144, 202, 249, 0.6);
		outline-offset: 3px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}

	.nav__list {
		display: flex;
		align-items: center;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav__link {
		font-weight: 500;
		padding: 0.5rem 0.85rem;
		border-radius: 999px;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.nav__link:hover,
	.nav__link:focus-visible {
		background: rgba(144, 202, 249, 0.25);
		color: var(--color-text);
		text-decoration: none;
	}

	@media (max-width: 900px) {
		.nav__list {
			gap: 0.5rem;
		}
	}

	@media (max-width: 720px) {
		.menu-toggle {
			display: inline-flex;
		}

		.nav__list {
			position: absolute;
			right: 1rem;
			top: calc(var(--header-height) + 0.5rem);
			flex-direction: column;
			align-items: flex-start;
			padding: 1.25rem;
			border-radius: var(--radius-medium);
			background: rgba(255, 255, 255, 0.96);
			border: 1px solid rgba(38, 50, 56, 0.08);
			box-shadow: var(--shadow-card);
			min-width: 200px;
			display: none;
		}

		.nav__list[data-open] {
			display: flex;
		}
	}
</style>
