---
// PetaPotensi.astro — client-only map using Leaflet via CDN
---

<div id="map" style="height:500px; width:100%; border-radius:8px;">
  <p style="text-align:center;">Memuat peta...</p>
</div>

<script client:load>
  (async () => {
    try {
      // Load Leaflet CSS (CDN) if not present
      if (!document.querySelector('link[data-leaflet-cdn]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        link.setAttribute('data-leaflet-cdn', '');
        document.head.appendChild(link);
      }

      // Load Leaflet JS via script tag and wait until it's available as window.L
      const loadLeaflet = () => new Promise((resolve, reject) => {
        if (window.L && window.L.map) return resolve(window.L);
        const script = document.createElement('script');
        script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        script.onload = () => resolve(window.L);
        script.onerror = (e) => reject(new Error('Failed to load Leaflet script'));
        document.body.appendChild(script);
      });

      const L = await loadLeaflet();

      // Use custom image as map background (CRS.Simple)
      // Image must be placed under `public/` (you said: /public/images/map_potensi_desa.jpg)
      const IMAGE_URL = '/images/map_potensi_desa.jpg';

      const mapContainer = document.getElementById('map');
      if (!mapContainer) throw new Error('Map container not found');
      mapContainer.innerHTML = '';

      // Load image to get dimensions
      const imgSize = await new Promise((resolve, reject) => {
        const img = new Image();
        img.src = IMAGE_URL;
        img.onload = () => resolve({ width: img.width, height: img.height });
        img.onerror = () => reject(new Error('Gagal memuat gambar peta'));
      });

      const w = imgSize.width;
      const h = imgSize.height;

      // Create map with CRS.Simple so coordinates match image pixels
      const map = L.map(mapContainer, {
        crs: L.CRS.Simple,
        minZoom: -5,
        maxZoom: 2,
        zoomSnap: 0.25
      });

      // Image bounds: top-left [0,0], bottom-right [h, w] (y, x)
      const imageBounds = [[0, 0], [h, w]];

      // Add image overlay
      L.imageOverlay(IMAGE_URL, imageBounds).addTo(map);

      // Restrict map to image bounds so user cannot pan outside
      map.setMaxBounds(imageBounds);
      map.fitBounds(imageBounds);

      // Show current zoom controls
      L.control.zoom({ position: 'topright' }).addTo(map);

      // Show coordinates on click to help you place markers later
      map.on('click', (e) => {
        // For CRS.Simple, lat = y, lng = x in pixel units relative to image
        const x = Number(e.latlng.lng.toFixed(3));
        const y = Number(e.latlng.lat.toFixed(3));
        const popup = L.popup()
          .setLatLng(e.latlng)
          .setContent(`<div style="font-size:0.95rem">Koordinat gambar: <code>[${x}, ${y}]</code><br/><button id=\"copy-coords\">Salin</button></div>`)
          .openOn(map);

        // attach copy handler after popup added
        setTimeout(() => {
          const btn = document.getElementById('copy-coords');
          if (btn) btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(`${x},${y}`);
              btn.textContent = 'Disalin';
            } catch (err) {
              btn.textContent = 'Gagal';
            }
          });
        }, 50);
      });

      // Load markers from public data (coordinates expected as [x, y] pixels)
      try {
        const resp = await fetch('/data/potensi.json');
        if (resp.ok) {
          const markers = await resp.json();
          const defaultIcon = L.icon({
            iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
            iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
            shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
            iconSize: [22, 36],
            iconAnchor: [11, 36],
            popupAnchor: [1, -30]
          });

          markers.forEach((p) => {
            if (!Array.isArray(p.koordinat) || p.koordinat.length < 2) return;
            const x = Number(p.koordinat[0]);
            const y = Number(p.koordinat[1]);
            // In CRS.Simple, lat = y, lng = x
            const latlng = [y, x];
            const marker = L.marker(latlng, { icon: defaultIcon }).addTo(map);
            const imgHtml = p.gambar ? `<img src="${p.gambar}" alt="${p.nama}" style="width:100%;height:auto;border-radius:8px;margin-top:6px;" />` : '';
            marker.bindPopup(`
              <div style="text-align:left; max-width:240px;">
                <strong>${p.nama}</strong>
                <p style="margin:6px 0 0 0; font-size:0.95rem;">${p.deskripsi || ''}</p>
                ${imgHtml}
              </div>
            `);
          });
        }
      } catch (err) {
        console.warn('Could not load markers:', err);
      }

    } catch (error) {
      console.error('Error loading map:', error);
      const mapContainer = document.getElementById('map');
      if (mapContainer) {
        mapContainer.innerHTML = '<p style="text-align:center;color:red;">Peta gagal ditampilkan</p>';
      }
    }
  })();
</script>

<style>
  #map {
    height: 500px;
    width: 100%;
    border-radius: 8px;
  }

  /* Make sure Leaflet's default styles don't get overridden */
  .leaflet-container {
    border-radius: 8px;
  }
</style>