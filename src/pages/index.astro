---
import BaseLayout from "../layouts/BaseLayout.astro";
import CardProgram from "../components/CardProgram.astro";
import CardPerson from "../components/CardPerson.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import data from "../data/data.json";

const { programDesa = [], perangkatDesa = [], ceritaWarga = [], statistik } = data;

const kepalaDesa =
	perangkatDesa.find((person) => person.jabatan?.toLowerCase().includes("kepala")) ?? perangkatDesa[0];

const ceritaUnggulan = ceritaWarga.slice(0, 2);

const numberFormatter = new Intl.NumberFormat("id-ID");

const usia = statistik?.proporsiUsia ?? { anakAnak: 0, dewasa: 0, lansia: 0 };
const usiaTotalPertama = usia.anakAnak;
const usiaTotalKedua = usia.anakAnak + usia.dewasa;

const statsCards = statistik
	? [
			{
				label: "Jumlah Penduduk",
				value: `${numberFormatter.format(statistik.jumlahPenduduk)} jiwa`,
				detail: "Data 2025",
			},
			{
				label: "Jumlah RT",
				value: `${statistik.jumlahRT}`,
				detail: "Lingkungan aktif",
			},
			{
				label: "Luas Wilayah",
				value: `${statistik.luasWilayahHa} ha`,
				detail: "Bentang Sendangan",
			},
			{
				label: "Proporsi Usia",
				value: `${usia.dewasa}% Dewasa`,
				detail: `Anak ${usia.anakAnak}% • Lansia ${usia.lansia}%`,
			},
		]
	: [];

const sectionNav = [
	{ id: "tentang", label: "Tentang" },
	{ id: "data", label: "Data" },
	{ id: "cerita", label: "Cerita" },
	{ id: "program", label: "Program" },
	{ id: "galeri", label: "Galeri" },
	{ id: "lokasi", label: "Lokasi" },
];

const galleryImages = [
	{ src: "/images/dokumentasi/program_web.jpg", alt: "Pembuatan website desa Sendangan" },
	{ src: "/images/dokumentasi/gotong_royong.jpg", alt: "Kegiatan gotong royong warga" },
	{ src: "/images/foto/oma_lina.jpg", alt: "Potret Oma Lina" },
	{ src: "/images/foto/rico.jpg", alt: "Pemuda Desa Sendangan" },
	{ src: "/images/dokumentasi/senam_lansia.jpg", alt: "Senam lansia di balai desa" },
	{ src: "/images/dokumentasi/kkt_tim.jpg", alt: "Tim KKT 144 UNSRAT" },
];

const pieStyle = statistik
	? `background-image: radial-gradient(circle at center, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.1) 60%, transparent 60%), conic-gradient(#90caf9 0 ${usiaTotalPertama}%, #80cbc4 ${usiaTotalPertama}% ${usiaTotalKedua}%, #f48fb1 ${usiaTotalKedua}% 100%)`
	: "";
---
<BaseLayout title="Desa Sendangan | Beranda" description="Beranda website resmi Desa Sendangan, Tompaso">
	<section class="hero" data-animate style="--hero-figure: url('/images/hero/rumah-transparan.png')">
		<div class="container hero__grid">
			<div class="hero__content">
				<span class="eyebrow">Selamat Datang</span>
				<h1>Website Desa Sendangan</h1>
				<p>
					Berada di dataran Tompaso, Desa Sendangan adalah komunitas kecil yang berpegang pada semangat gotong royong.
					Kami merawat identitas desa, mengarsipkan cerita warga, dan membuka ruang kolaborasi bagi generasi muda.
				</p>
				<div class="hero__actions">
					<a class="button button--primary" href="#tentang">Kenali Kami</a>
					<a class="button button--ghost" href="/profil">Lihat Profil Desa</a>
				</div>
				<div class="hero__meta surface" data-animate>
					<div>
						<span class="hero__meta-label">Jumlah Penduduk</span>
						<span class="hero__meta-value">
							{statistik ? numberFormatter.format(statistik.jumlahPenduduk) : "-"}
						</span>
					</div>
					<div>
						<span class="hero__meta-label">Jumlah RT</span>
						<span class="hero__meta-value">{statistik ? statistik.jumlahRT : "-"}</span>
					</div>
					<div>
						<span class="hero__meta-label">Luas Wilayah</span>
						<span class="hero__meta-value">{statistik ? `${statistik.luasWilayahHa} ha` : "-"}</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<nav class="section-toc" aria-label="Navigasi konten halaman">
			<div class="container section-toc__inner">
						<button
				class="section-toc__toggle"
				type="button"
							aria-expanded="false"
				aria-controls="section-toc-panel"
				data-toc-toggle
			>
				<span class="section-toc__icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<path d="M4 6h16M7 12h13M10 18h10" stroke-linecap="round" />
						<path d="M4 12h.01M4 18h.01" stroke-linecap="round" />
					</svg>
				</span>
				<span>Ringkasan Halaman</span>
			</button>
							<div class="section-toc__panel" id="section-toc-panel" role="list" data-toc-panel hidden>
				{sectionNav.map((item) => (
					<a class="section-toc__link" href={`#${item.id}`} data-section-link={item.id}>
						{item.label}
					</a>
				))}
			</div>
		</div>
	</nav>

	<section id="tentang" data-section data-animate>
		<div class="container about">
			<div class="section-heading">
				<span class="eyebrow">Selamat Datang</span>
				<h2>Website Desa Sendangan</h2>
				<p>
					Sendangan adalah desa yang tumbuh di lereng pegunungan Tompaso. Meskipun jumlah penduduknya sedikit, desa
					ini menyimpan sejarah perjuangan mempertahankan identitas di tengah laju modernisasi. Kehangatan terasa dari
					sapaan warga, kebersihan lingkungan, hingga kegiatan ibadah yang rutin dilaksanakan.
				</p>
			</div>
			<div class="about__grid">
				<article class="about__story surface" data-animate>
					<p>
						{`Dikelilingi hamparan kebun dan udara sejuk, Sendangan menjadi rumah bagi ${statistik ? numberFormatter.format(statistik.jumlahPenduduk) : "puluhan"} warga yang saling mengenal.`}
					</p>
					{kepalaDesa && (
						<CardPerson
							name={kepalaDesa.nama}
							role={kepalaDesa.jabatan}
							quote="Kami ingin desa ini tetap hidup, maju, dan tetap hangat bagi siapa pun yang pulang."
							photo={kepalaDesa.foto}
						/>
					)}
				</article>
				<figure class="about__map surface" role="group" aria-labelledby="map-title" data-animate>
					<div class="about__map-visual" role="img" aria-label="Peta Desa Sendangan"></div>
					<figcaption id="map-title">Peta administratif Desa Sendangan</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<section id="data" data-section data-animate>
		<div class="container data">
			<div class="section-heading">
				<span class="eyebrow">Data Singkat</span>
				<h2>Angka-angka penting yang menggambarkan desa</h2>
				<p>
					Data demografis dirangkum untuk memberi gambaran cepat mengenai kondisi desa. Kami menjaga agar informasi ini
					selalu diperbarui melalui koordinasi perangkat desa dan warga.
				</p>
			</div>
			<div class="data__grid">
				<div class="data__cards surface" data-animate>
					{statsCards.map((item) => (
						<div class="data__card">
							<span class="data__value">{item.value}</span>
							<span class="data__label">{item.label}</span>
							<span class="data__detail">{item.detail}</span>
						</div>
					))}
				</div>
				<div class="data__chart surface" data-animate>
					<div class="data__chart-visual" style={pieStyle} role="img" aria-label="Proporsi usia penduduk"></div>
					<div class="data__chart-legend">
						<div>
							<span class="legend-dot legend-dot--anak"></span>
							Anak-anak {usia.anakAnak}%
						</div>
						<div>
							<span class="legend-dot legend-dot--dewasa"></span>
							Dewasa {usia.dewasa}%
						</div>
						<div>
							<span class="legend-dot legend-dot--lansia"></span>
							Lansia {usia.lansia}%
						</div>
					</div>
					<p class="data__source">Sumber: Pemerintah Desa Sendangan, 2025</p>
				</div>
			</div>
		</div>
	</section>

	<section id="cerita" data-section data-animate>
		<div class="container stories">
			<div class="section-heading">
				<span class="eyebrow">Cerita Warga</span>
				<h2>Suara yang membuat Sendangan tetap hidup</h2>
				<p>
					Cerita singkat warga senior dan generasi muda yang terus menjaga Sendangan. Mereka adalah wajah humanis desa
					yang menyambut siapa saja dengan tangan terbuka.
				</p>
			</div>
			<div class="stories__grid">
				{ceritaUnggulan.map((cerita) => (
					<CardPerson
						name={cerita.nama}
						role={`Usia ${cerita.usia} tahun`}
						quote={cerita.kutipan}
						photo={cerita.foto}
					/>
				))}
			</div>
		</div>
	</section>

	<section id="program" data-section data-animate>
		<div class="container program">
			<div class="section-heading">
				<span class="eyebrow">Program &amp; Inisiatif</span>
				<h2>Kolaborasi desa dan warga untuk menjaga lingkungan</h2>
				<p>
					Program yang dijalankan warga dan kolaborator KKT 144 UNSRAT. Setiap inisiatif didokumentasikan agar mudah
					dipelajari dan dilanjutkan.
				</p>
			</div>
			<div class="program__grid">
				{programDesa.map((program) => (
					<CardProgram
						title={program.judul}
						description={program.deskripsi}
						image={program.gambar}
						highlight="Program Desa"
					/>
				))}
			</div>
			<div class="program__cta">
				<a class="button button--primary" href="/program">Lihat semua program</a>
			</div>
		</div>
	</section>

	<section id="galeri" data-section data-animate>
		<div class="container galeri">
			<div class="section-heading">
				<span class="eyebrow">Galeri</span>
				<h2>Potret kegiatan dan kehangatan warga</h2>
				<p>
					Dokumentasi visual dari kegiatan gotong royong, belajar bersama, hingga suasana rumah warga. Galeri lengkap
					tersedia di halaman khusus.
				</p>
			</div>
			<GalleryGrid images={galleryImages} />
			<div class="galeri__cta">
				<a class="button button--ghost" href="/galeri">Lihat galeri lengkap</a>
			</div>
		</div>
	</section>

	<section id="lokasi" data-section data-animate>
		<div class="container lokasi surface">
			<div class="lokasi__info">
				<span class="eyebrow">Lokasi &amp; Kontak</span>
				<h2>Kantor Desa Sendangan</h2>
				<p>
					Jl. Raya Tompaso No. 1, Desa Sendangan, Tompaso. Kantor desa buka setiap hari kerja untuk pelayanan administrasi,
					konsultasi program, dan koordinasi kegiatan warga.
				</p>
				<ul class="lokasi__list">
					<li><strong>Jam Pelayanan:</strong> Senin - Jumat, 08.00 - 15.00 WITA</li>
					<li><strong>Email:</strong> <a href="mailto:sendangan.desa@gmail.com">sendangan.desa@gmail.com</a></li>
					<li><strong>WhatsApp:</strong> <a href="https://wa.me/6281234567890">+62 812-3456-7890</a></li>
				</ul>
				<div class="lokasi__actions">
					<a class="button button--primary" href="/kontak">Hubungi perangkat desa</a>
					<a class="button button--ghost" href="https://maps.app.goo.gl/" target="_blank" rel="noopener">Buka peta</a>
				</div>
			</div>
			<div class="lokasi__map" role="img" aria-label="Lokasi Kantor Desa Sendangan"></div>
		</div>
	</section>

	<button
		class="back-to-top"
		type="button"
		aria-label="Kembali ke atas"
		data-back-to-top
		hidden
	>
		<span class="back-to-top__icon" aria-hidden="true"></span>
	</button>

	<script is:inline>
		const sectionElements = document.querySelectorAll("[data-section]");
		const tocToggle = document.querySelector("[data-toc-toggle]");
		const tocPanel = document.querySelector("[data-toc-panel]");
		const chips = new Map();
		const backToTopButton = document.querySelector("[data-back-to-top]");

		const setTocState = (open) => {
				if (!tocToggle || !tocPanel) return;
				tocToggle.setAttribute("aria-expanded", String(open));
				tocPanel.hidden = !open ? true : false;
			if (open) {
				tocPanel.setAttribute("data-open", "true");
			} else {
				tocPanel.removeAttribute("data-open");
			}
		};

		setTocState(false);

		tocToggle?.addEventListener("click", () => {
			const isOpen = tocToggle.getAttribute("aria-expanded") === "true";
			setTocState(!isOpen);
		});

		const maybeCloseToc = (event) => {
			if (!tocToggle || !tocPanel || tocPanel.hidden) return;
			if (tocToggle.contains(event.target) || tocPanel.contains(event.target)) return;
			setTocState(false);
		};

			document.addEventListener("click", maybeCloseToc);
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				setTocState(false);
			}
		});

			document.querySelectorAll("[data-section-link]").forEach((link) => {
			chips.set(link.getAttribute("data-section-link"), link);
			link.addEventListener("click", () => setTocState(false));
		});

			// Default closed on load (no action needed)

			const updateBackToTop = () => {
				if (!backToTopButton) return;
				const shouldShow = window.scrollY > 220;
				if (shouldShow) {
					backToTopButton.removeAttribute("hidden");
				} else {
					backToTopButton.setAttribute("hidden", "");
				}
			};

			backToTopButton?.addEventListener("click", () => {
				window.scrollTo({ top: 0, behavior: "smooth" });
			});

			window.addEventListener("scroll", updateBackToTop);
			updateBackToTop();

		if ("IntersectionObserver" in window) {
			const navObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const link = chips.get(entry.target.id);
						if (!link) return;
						if (entry.isIntersecting) {
							link.setAttribute("data-active", "true");
							link.setAttribute("aria-current", "true");
						} else {
							link.removeAttribute("data-active");
							link.removeAttribute("aria-current");
						}
					});
				},
				{
					threshold: 0.4,
					rootMargin: "-45% 0px -45% 0px",
				}
			);

			sectionElements.forEach((section) => navObserver.observe(section));

			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							observer.unobserve(entry.target);
						}
					});
				},
				{
					threshold: 0.25,
					rootMargin: "0px 0px -10% 0px",
				}
			);

			document.querySelectorAll("[data-animate]").forEach((el) => revealObserver.observe(el));
		}
	</script>

	<style>
		[hidden] {
			display: none !important;
		}

		.back-to-top {
			position: fixed;
			right: clamp(1.25rem, 3vw, 2rem);
			bottom: clamp(1.25rem, 4vw, 2.5rem);
			width: 52px;
			height: 52px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border: none;
			border-radius: var(--radius-medium);
			background: rgba(255, 255, 255, 0.92);
			box-shadow: 0 20px 32px -24px rgba(38, 50, 56, 0.7);
			color: var(--color-text);
			cursor: pointer;
			transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, opacity 0.2s ease;
			z-index: 180;
		}

		.back-to-top:hover,
		.back-to-top:focus-visible {
			transform: translateY(-3px);
			background: linear-gradient(135deg, rgba(144, 202, 249, 0.35), rgba(255, 224, 130, 0.35));
			box-shadow: 0 26px 40px -26px rgba(38, 50, 56, 0.75);
		}

		.back-to-top:focus-visible {
			outline: 3px solid rgba(144, 202, 249, 0.55);
			outline-offset: 3px;
		}

		.back-to-top__icon {
			width: 18px;
			height: 18px;
			border-top: 3px solid currentColor;
			border-left: 3px solid currentColor;
			transform: rotate(45deg);
			margin-top: 5px;
		}

		.hero {
			--hero-figure: none;
			position: relative;
			padding-top: clamp(4rem, 10vw, 6rem);
			padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
			background-color: #d7ebff;
			background-image: var(--hero-figure), linear-gradient(#d7ebff, #d7ebff);
			background-repeat: no-repeat, no-repeat;
			background-size: cover, cover;
			background-position: center, center;
			box-shadow: inset 0 -1px 0 rgba(38, 50, 56, 0.08);
			color: var(--color-text);
			overflow: hidden;
		}

		.hero__grid {
			display: grid;
			grid-template-columns: minmax(0, 560px);
			gap: clamp(2rem, 6vw, 4rem);
			align-items: center;
			justify-content: flex-start;
			position: relative;
			z-index: 1;
		}

		.hero__content p {
			font-size: 1.05rem;
			max-width: 520px;
		}

		.hero__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 1rem;
			margin: 1.5rem 0 2rem;
		}

		.hero__meta {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
			padding: 1.5rem;
			border-radius: var(--radius-large);
			background: rgba(255, 255, 255, 0.95);
		}

		.hero__meta-label {
			font-size: 0.9rem;
			color: var(--color-muted);
		}

		.hero__meta-value {
			font-size: 1.3rem;
			font-weight: 700;
			color: var(--color-text);
		}

		.hero__content {
			max-width: 560px;
			text-shadow: 0 0 10px rgba(215, 235, 255, 0.9), 0 0 2px rgba(215, 235, 255, 0.85);
		}

		.section-toc {
			position: sticky;
			top: calc(var(--header-height) + 1rem);
			z-index: 140;
			padding: 0.5rem 0 0;
		}

			.section-toc__inner {
				display: flex;
				justify-content: flex-end;
				align-items: flex-start;
				position: relative;
			}

		.section-toc__toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.6rem;
			padding: 0.65rem 1.2rem;
			border-radius: var(--radius-large);
			border: 1px solid rgba(38, 50, 56, 0.08);
			background: rgba(255, 255, 255, 0.92);
			box-shadow: 0 12px 24px -18px rgba(38, 50, 56, 0.5);
			font-weight: 600;
			color: var(--color-text);
			cursor: pointer;
			transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
		}

		.section-toc__toggle:hover,
		.section-toc__toggle:focus-visible {
			transform: translateY(-2px);
			border-color: rgba(144, 202, 249, 0.5);
			box-shadow: 0 18px 26px -18px rgba(38, 50, 56, 0.55);
			background: rgba(255, 255, 255, 0.98);
		}

		.section-toc__toggle:focus-visible {
			outline: 3px solid rgba(144, 202, 249, 0.55);
			outline-offset: 3px;
		}

		.section-toc__toggle[aria-expanded="true"] {
			background: linear-gradient(135deg, rgba(144, 202, 249, 0.9), rgba(255, 224, 130, 0.65));
			border-color: transparent;
		}

		.section-toc__icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 32px;
			height: 32px;
			border-radius: 999px;
			background: rgba(144, 202, 249, 0.18);
			color: var(--color-text);
		}

			.section-toc__panel {
				position: absolute;
				top: calc(100% + 0.75rem);
				right: 0;
			min-width: 240px;
			padding: 1.2rem;
			border-radius: var(--radius-large);
			border: 1px solid rgba(38, 50, 56, 0.08);
			box-shadow: 0 28px 40px -30px rgba(38, 50, 56, 0.55);
			background: rgba(255, 255, 255, 0.98);
			display: grid;
			gap: 0.5rem;
			z-index: 200;
		}

		.section-toc__panel::before {
			content: "";
			position: absolute;
				top: -10px;
				right: 24px;
			width: 16px;
			height: 16px;
			transform: rotate(45deg);
			background: inherit;
			border-left: 1px solid rgba(38, 50, 56, 0.08);
			border-top: 1px solid rgba(38, 50, 56, 0.08);
			z-index: -1;
		}

		.section-toc__link {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			padding: 0.6rem 0.75rem;
			border-radius: var(--radius-medium);
			background: rgba(144, 202, 249, 0.06);
			color: var(--color-muted);
			font-weight: 600;
			transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
		}

		.section-toc__link::after {
			content: "→";
			font-size: 0.85rem;
			opacity: 0.4;
			transition: transform 0.2s ease, opacity 0.2s ease;
		}

		.section-toc__link:hover,
		.section-toc__link:focus-visible {
			background: rgba(144, 202, 249, 0.18);
			color: var(--color-text);
			transform: translateX(4px);
			text-decoration: none;
		}

		.section-toc__link:hover::after,
		.section-toc__link:focus-visible::after {
			opacity: 0.7;
