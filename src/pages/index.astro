---
import BaseLayout from '../layouts/BaseLayout.astro';

const hero = {
	title: 'Desa Sendangan',
	description:
		'Website resmi Desa Sendangan sebagai pusat informasi warga, profil potensi desa, dan layanan digital.',
	cta: {
		label: 'Jelajahi Informasi',
		href: '#profil-desa',
	},
};
---

<BaseLayout title={hero.title} description={hero.description}>
	<section class="flex flex-col gap-8 text-center">
		<div class="flex flex-col gap-4">
			<p class="text-sm uppercase tracking-widest text-primary">Selamat datang</p>
			<h1 class="text-4xl font-semibold text-slate-900 sm:text-5xl">{hero.title}</h1>
			<p class="mx-auto max-w-2xl text-lg text-slate-600">{hero.description}</p>
		</div>
		<div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
			<a
				href={hero.cta.href}
				class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-md shadow-primary/20 transition hover:bg-primary/90"
			>
				{hero.cta.label}
			</a>
			<a href="#berita" class="text-sm font-semibold text-slate-600">Lihat Berita Terbaru</a>
		</div>
	</section>

	<section id="profil-desa" class="grid gap-6 rounded-3xl bg-white/90 p-8 shadow-lg shadow-slate-200/60 ring-1 ring-slate-100">
		<h2 class="text-2xl font-semibold text-slate-900">Sekilas Profil</h2>
		<p class="text-base leading-relaxed text-slate-600">
			Mulai kerjakan struktur halaman one-page di bagian ini. Anda dapat menambahkan statistik desa, profil layanan
			publik, peta interaktif Leaflet, grafik Chart.js, dan tautan menuju halaman detail sesuai kebutuhan.
		</p>
		<p class="text-sm text-slate-500">
			Konten dinamis tersedia melalui Content Collections di `src/content/`. Anda dapat memuat data terstruktur dari
			`src/data/` atau berkas MDX/Markdown di tiap koleksi sesuai kebutuhan situs.
		</p>
	</section>
</BaseLayout>
